# Normalize line endings: always store LF in the repo, and check out LF everywhere.
* text=auto eol=lf

# Binary files — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.ico  binary
*.woff binary
*.woff2 binary

# Windows-only scripts should stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf