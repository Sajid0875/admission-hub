# Normalize line endings: always store LF in the repo, and check out LF everywhere.
* text=auto eol=lf

# Binary files — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.ico  binary
*.woff binary
*.woff2 binary

# Env / secret-ish text — treat as text, but never commit real .env (see .gitignore)
.env.example text eol=lf
.env.test text eol=lf

# Windows-only scripts should stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
