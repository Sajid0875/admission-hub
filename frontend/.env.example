# WhiteDavid23 Admission Hub — frontend (local)
# Copy to .env.local (gitignored). Prefer: cp ../local/frontend.env.local.example .env.local
#
# Must match backend PORT (default 4000) — not macOS AirPlay :5000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# When true, services fall back to in-memory fixtures on network/404 errors
NEXT_PUBLIC_USE_MOCKS=false
