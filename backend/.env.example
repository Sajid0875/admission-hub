# --------------------------------------------------
# Server
# --------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# --------------------------------------------------
# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# --------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admission_hub?schema=public"

# --------------------------------------------------
# JWT (generate a long random string — see below)
# PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 64 | % {[char]$_})
# --------------------------------------------------
JWT_SECRET="9d94a3f9aeaa0c89e0e0537db35138430400eedf462d075e8f012995522079dc"
# Access JWT lifetime (short when using refresh tokens)
JWT_EXPIRES_IN="15m"
# Opaque refresh token lifetime (stored hashed in DB)
JWT_REFRESH_EXPIRES_IN="30d"

# --------------------------------------------------
# Logging
# --------------------------------------------------
LOG_LEVEL=info

# --------------------------------------------------
# Follow-up reminders (in-process scanner; not Redis)
# --------------------------------------------------
FOLLOWUP_REMINDERS_ENABLED=true
FOLLOWUP_REMINDER_INTERVAL_MS=60000
FOLLOWUP_DUE_SOON_MINUTES=60

# --------------------------------------------------
# WhatsApp adapter (stub by default — no external calls)
# Live options:
#   WHATSAPP_PROVIDER=meta   + META token / phone-number-id
#   WHATSAPP_PROVIDER=twilio + ACCOUNT_SID / AUTH_TOKEN / FROM
# --------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=stub
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_API_VERSION=v21.0
# WHATSAPP_TWILIO_ACCOUNT_SID=
# WHATSAPP_TWILIO_AUTH_TOKEN=
# WHATSAPP_TWILIO_FROM=+14155238886
