# --------------------------------------------------
# Server
# --------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# --------------------------------------------------
# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# --------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admission_hub?schema=public"

# --------------------------------------------------
# JWT — REQUIRED: generate your own (never commit a real secret)
#   openssl rand -hex 32
# Also keep a copy under local/backend.env (gitignored).
# --------------------------------------------------
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_hex_32"
# Access JWT lifetime (short when using refresh tokens)
JWT_EXPIRES_IN="15m"
# Opaque refresh token lifetime (stored hashed in DB)
JWT_REFRESH_EXPIRES_IN="30d"

# --------------------------------------------------
# Logging
# --------------------------------------------------
LOG_LEVEL=info

# --------------------------------------------------
# Follow-up reminders (in-process scanner; not Redis)
# --------------------------------------------------
FOLLOWUP_REMINDERS_ENABLED=true
FOLLOWUP_REMINDER_INTERVAL_MS=60000
FOLLOWUP_DUE_SOON_MINUTES=60

# --------------------------------------------------
# WhatsApp adapter (stub by default — no external calls)
# Live options:
#   WHATSAPP_PROVIDER=meta   + META token / phone-number-id
#   WHATSAPP_PROVIDER=twilio + ACCOUNT_SID / AUTH_TOKEN / FROM
# --------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=stub
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_API_VERSION=v21.0
# WHATSAPP_TWILIO_ACCOUNT_SID=
# WHATSAPP_TWILIO_AUTH_TOKEN=
# WHATSAPP_TWILIO_FROM=+14155238886

# --------------------------------------------------
# Online payment gateway (stub by default — no external calls)
# Live: PAYMENT_GATEWAY_ENABLED=true + PROVIDER=razorpay + keys
# --------------------------------------------------
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PROVIDER=stub
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=
# Optional dedicated HMAC secret for intent tokens (falls back to JWT_SECRET)
# PAYMENT_INTENT_SECRET=

# Docker / Railway boot: migrate + optional seed
# RUN_SEED=true
