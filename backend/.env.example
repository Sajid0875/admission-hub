# --------------------------------------------------
# Server
# --------------------------------------------------
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

# --------------------------------------------------
# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# --------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/admission_hub?schema=public"

# --------------------------------------------------
# JWT (generate a long random string — see below)
# PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 64 | % {[char]$_})
# --------------------------------------------------
JWT_SECRET="9d94a3f9aeaa0c89e0e0537db35138430400eedf462d075e8f012995522079dc"
JWT_EXPIRES_IN="7d"

# --------------------------------------------------
# Logging
# --------------------------------------------------
LOG_LEVEL=info